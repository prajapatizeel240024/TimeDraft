# Local Postgres only. scripts/db.ts refuses any host other than localhost or 127.0.0.1.
DATABASE_URL=postgres://timedraft:timedraft@127.0.0.1:5432/time_draft_dev
EVAL_DATABASE_URL=postgres://timedraft:timedraft@127.0.0.1:5432/time_draft_eval

# Claude. Put the real key in .env.local, which git ignores.
ANTHROPIC_API_KEY=
MODEL_MATCH=claude-haiku-4-5-20251001
MODEL_DRAFT=claude-sonnet-5-5
# Signs Claude's rewrite suggestions, so a save counts as Claude's only with a valid token. Empty = a random key per process.
REWRITE_SIGNING_KEY=

# anthropic = real Claude calls. oracle = answer-key stand-in for testing without a key (never for results).
LLM_MODE=anthropic
# on = replay identical requests from the llm_calls table; off = always call the API.
LLM_CACHE=on

# Claude's match answers below this confidence go to the review queue.
MATCH_THRESHOLD=0.80

# ts = TypeScript checker in-process; go = the checker-go service at CHECKER_URL.
CHECKER_IMPL=ts
CHECKER_URL=http://127.0.0.1:8081
